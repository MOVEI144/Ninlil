@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/NinlilTargets.cmake")
if(NOT DEFINED Ninlil_JOURNAL_BACKEND)
  set(Ninlil_JOURNAL_BACKEND posix)
endif()
if(NOT Ninlil_JOURNAL_BACKEND MATCHES "^(posix|flash_runtime)$")
  set(Ninlil_FOUND FALSE)
  set(Ninlil_NOT_FOUND_MESSAGE "Select posix or flash_runtime for Ninlil_JOURNAL_BACKEND")
  return()
endif()
# Core and journal are one selected static backend. Declare this dependency on
# every archive which calls them, so consumer link order cannot drop symbols.
get_property(selected TARGET Ninlil::posix PROPERTY NINLIL_PACKAGE_BACKEND)
if(selected AND NOT selected STREQUAL Ninlil_JOURNAL_BACKEND)
  set(Ninlil_FOUND FALSE)
  set(Ninlil_NOT_FOUND_MESSAGE "One Ninlil journal backend is required per build")
  return()
endif()
if(NOT selected)
set_property(TARGET Ninlil::posix PROPERTY NINLIL_PACKAGE_BACKEND ${Ninlil_JOURNAL_BACKEND})
foreach(component node routed control_log secure bulk fanout_store fanout_core)
  if(TARGET Ninlil::${component})
    target_link_libraries(Ninlil::${component} INTERFACE Ninlil::${Ninlil_JOURNAL_BACKEND})
  endif()
endforeach()
endif()
set(Ninlil_VERSION 0.1.0)
set(Ninlil_core_FOUND TRUE)
if(TARGET Ninlil::bulk)
  set(Ninlil_bulk_FOUND TRUE)
endif()
if(TARGET Ninlil::node)
  set(Ninlil_secure_FOUND TRUE)
  set(Ninlil_CRYPTO_PROFILE "pinned upstream host reference; ESP uses SDK PSA")
endif()
if(TARGET Ninlil::adaptive)
  set(Ninlil_adaptive_FOUND TRUE)
endif()
if(TARGET Ninlil::fanout_store)
  set(Ninlil_fanout_store_FOUND TRUE)
  set(Ninlil_fanout_core_FOUND TRUE)
endif()
check_required_components(Ninlil)
